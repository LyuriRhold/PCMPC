# Local development. Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pcmpc
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/pcmpc_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-32-byte-secret
CRON_SECRET=replace-with-a-random-32-byte-secret

APP_TZ=Asia/Manila
APP_ENV=development

APP_URL=http://localhost:3000

# First admin, created by npm run db:seed (password: at least 10 characters).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Local PostgreSQL (scripts/db.mjs). PG_MODE: portable | service | external (auto-detected when unset).
# PG_HOME=C:\Users\<you>\AppData\Local\pcmpc-pg
# PG_SERVICE=postgresql-x64-18
